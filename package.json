{
  "name": "seaofsand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server:publish": "cd server && spacetime publish --server http://localhost:3000 seaofsand",
    "server:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path server"
  },
  "dependencies": {
    "spacetimedb": "^2.6.1",
    "three": "^0.166.0"
  },
  "devDependencies": {
    "@types/three": "^0.166.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
